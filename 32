											local lookVector = v6.cframe.LookVector
											local lookVector2 = v7.cframe.LookVector
											local v8 = lookVector:Cross(lookVector2)
											local v9 = lookVector:Dot(lookVector2)
											local n7 = math.atan2(v8.Magnitude, v9)

