tbl.pushBarrelProtect.getActiveBarrels = function()
	local tbl6 = {}
	local zombies = workspace:FindFirstChild("Zombies")
	if not zombies then
		return tbl6
	end

	for _, v16 in zombies:GetChildren() do
		if v16:IsA("Model") and tbl.pushBarrelProtect.isBarrel(v16) then
			local humanoidRootPart = v16:FindFirstChild("HumanoidRootPart") or v16:FindFirstChild("Torso") or v16:FindFirstChild("Head")

			if humanoidRootPart then
				table.insert(tbl6, humanoidRootPart.Position)
			end
		end
	end

	return tbl6
end

tbl.pushBarrelProtect.isPointInEllipsoid = function(arg, arg2, arg3, arg4)
	local n = arg.X - arg2.X
	local n2 = arg.Y - arg2.Y
	local n3 = arg.Z - arg2.Z
	return (n * n + n3 * n3) / arg3 * arg3 + n2 * n2 / arg4 * arg4 < 1
end

tbl.pushBarrelProtect.applyPush = function()
	if not tbl.pushBarrelProtect.enabled then
		return
	end
	local character = localPlayer.Character
	if not character then
		return
	end
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then
		return
	end
	local position = humanoidRootPart.Position
	local v16, v17 = tbl.pushBarrelProtect.getRadii()

	for _, v18 in tbl.pushBarrelProtect.getActiveBarrels(), nil, nil do
		if tbl.pushBarrelProtect.isPointInEllipsoid(position, v18, v16, v17) then
			local n = position - v18

			if tbl.pushBarrelProtect.verticalThreshold < abs(n.Y) then
				local v19 = vector(n.X, 0, n.Z)
				local vector3

				if v19.Magnitude < 0.001 then
					vector3 = Vector3.new(1, 0, 0)
				else
					vector3 = v19.Unit
				end

				local n2 = vector3 * tbl.pushBarrelProtect.slideForce
				humanoidRootPart.AssemblyLinearVelocity = vector(n2.X, humanoidRootPart.AssemblyLinearVelocity.Y, n2.Z)
			else
				local unit = n.Unit

				if unit.Magnitude < 0.001 then
					unit = Vector3.new(1, 0, 0)
				end

				humanoidRootPart.AssemblyLinearVelocity = unit * tbl.pushBarrelProtect.normalForce + vector(0, tbl.pushBarrelProtect.normalUp, 0)
			end

			break
		end
	end
end

tbl.pushBarrelProtect.loop = function()
