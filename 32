					weldConstraint.Part0 = v3.part0
					weldConstraint.Part1 = v3.part1
				else
					weldConstraint = Instance.new(v3.className)
					weldConstraint.Part0 = v3.part0
					weldConstraint.Part1 = v3.part1
					weldConstraint.C0 = v3.c0
					weldConstraint.C1 = v3.c1
				end

				weldConstraint.Name = v3.name
				weldConstraint.Parent = v3.parent and v3.parent.Parent and v3.parent or v3.part0
			end
		end

		for _, v3 in tbl.invisTool.disabledScripts, nil, nil do
			if v3 and v3.Parent then
				v3.Disabled = false
			end
		end
	end

	tbl.invisTool.savedJoints = {}
	tbl.invisTool.disabledScripts = {}

	if tbl.invisTool.holdVelocity then
