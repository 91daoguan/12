				local v6 = tbl.autoFindDoctor.getHealth()
				local n = v6 / tbl.autoFindDoctor.getMaxHealth() * 100

				if tbl.autoFindDoctor.trigger <= n then
					if tbl.autoFindDoctor.teleportCount > 0 then
