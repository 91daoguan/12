tbl.rescueTeammate.getHRP = function(arg)
	return arg and arg:FindFirstChild("HumanoidRootPart")
end

tbl.rescueTeammate.getPin = function(arg)
	local ok, result = pcall(function()
		return workspace:FindFirstChild("Players")[arg.Name].UserStates.Pin.Value
	end)

	return ok and tostring(result) ~= "None"
end

tbl.rescueTeammate.getInf = function(arg)
	local ok, result = pcall(function()
		return workspace:FindFirstChild("Players")[arg.Name].UserStates.Infected.Value
	end)

	return ok and result or 0
end

tbl.rescueTeammate.hasZombie = function(arg, arg2)
	for _, v16 in workspace:GetDescendants() do
		if v16:IsA("Model") and v16.Name == "m_Zombie" then
			local humanoidRootPart = v16:FindFirstChild("HumanoidRootPart")
			if humanoidRootPart and (humanoidRootPart.Position - arg).Magnitude <= arg2 then
				return true
			end
		end
	end

	return false
end

tbl.rescueTeammate.loop = function()
	while tbl.rescueTeammate.enabled do
		task.wait(0.25)

		if not tbl.rescueTeammate.busy then
			for _, v16 in Players:GetPlayers() do
				if v16 == localPlayer then
					continue
				elseif tbl.rescueTeammate.enabled then
					if tbl.rescueTeammate.inf[v16.Name] == nil then
						tbl.rescueTeammate.inf[v16.Name] = tbl.rescueTeammate.getInf(v16)
					end

					local flag

					if tbl.rescueTeammate.getPin(v16) then
						flag = true
					else
						local v17 = tbl.rescueTeammate.getInf(v16)
						local flag2 = v17 > (tbl.rescueTeammate.inf[v16.Name] or v17) and v17 > 0
						flag = false

						if flag2 then
							local character = v16.Character
							character = character and tbl.rescueTeammate.getHRP(character)
							character = character and tbl.rescueTeammate.hasZombie(character.Position, 2)
							flag = false

							if character then
								local str2 = "感染" .. floor(v17) .. "%"
								flag = true
							end
						end

						tbl.rescueTeammate.inf[v16.Name] = v17
					end

					if flag then
						tbl.rescueTeammate.busy = true
						tbl.rescueTeammate.inf[v16.Name] = tbl.rescueTeammate.getInf(v16)
						local character = localPlayer.Character
						local v17 = character and tbl.rescueTeammate.getHRP(character)

						if not v17 then
							tbl.rescueTeammate.busy = false
						else
							local position = v17.Position
							local character2 = v16.Character
							local v18 = character2 and tbl.rescueTeammate.getHRP(character2)

							if not v18 then
								tbl.rescueTeammate.busy = false
							else
								pcall(function()
									v17.CFrame = cframe(v18.Position + Vector3.new(0, 0.5, 0))
								end)

								local v19 = v()

								while true do
									if tbl.rescueTeammate.enabled and v() - v19 < 6 then
										task.wait(0.2)

										if not (v() - v19 >= 0.8) then
											continue
										elseif not tbl.rescueTeammate.getPin(v16) then
											local character3 = v16.Character
											character3 = character3 and tbl.rescueTeammate.getHRP(character3)
											if not (character3 and not tbl.rescueTeammate.hasZombie(character3.Position, 2)) then
												continue
											end
										else
											continue
										end
									end

									break
								end

								task.wait(0.15)
								local character3 = localPlayer.Character
								character3 = character3 and tbl.rescueTeammate.getHRP(character3)

								if character3 then
									pcall(function()
										character3.CFrame = cframe(position + Vector3.new(0, 1, 0))
									end)
								end

								tbl.rescueTeammate.busy = false
								task.wait(0.5)
							end
						end
					end

					continue
				end

				break
			end
		end
	end
end

tbl.rescueTeammate.start = function()
	if tbl.rescueTeammate.thread then
		return
	end
	tbl.rescueTeammate.enabled = true
	tbl.rescueTeammate.inf = {}
	tbl.rescueTeammate.busy = false
	tbl.rescueTeammate.thread = task.spawn(tbl.rescueTeammate.loop)
