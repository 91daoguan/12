tbl.flyAway.ToggleCore = function(isEnabled)
	tbl.flyAway.isEnabled = isEnabled

	for _, v3 in tbl.flyAway.connections, nil, nil do
		if v3 then
			pcall(function()
				v3:Disconnect()
			end)
		end
	end

	tbl.flyAway.connections = {}

	if tbl.flyAway.isEnabled then
		local connection = RunService.Stepped:Connect(function()
			if not tbl.flyAway.isEnabled then
				return
			end
			local v3 = tbl.flyAway.SafeGetCharacter(localPlayer)
			local v4 = tbl.flyAway.SafeGetHumanoid(v3)
			local v5 = tbl.flyAway.SafeGetHRP(v3)

			if v4 and v5 then
				pcall(function()
					v4.PlatformStand = false
					v4.Sit = false
					v4.AutoRotate = true
					local state = v4:GetState()

					if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Ragdoll then
						v4:ChangeState(Enum.HumanoidStateType.GettingUp)
					end
				end)
			end

			if tbl.flyAway.isEnabled then
				for _, v6 in Players:GetPlayers() do
					if v6 ~= localPlayer then
						local v7 = tbl.flyAway.SafeGetCharacter(v6)

						if v7 then
							for _, v8 in v7:GetDescendants() do
								if v8:IsA("BasePart") then
									pcall(function()
										v8.CanCollide = false
									end)
								end
							end
						end
					end
				end
			end
		end)

		table.insert(tbl.flyAway.connections, connection)

		local connection2 = RunService.Heartbeat:Connect(function()
			if not tbl.flyAway.isEnabled then
				return
			end
			local v3 = tbl.flyAway.SafeGetCharacter(localPlayer)
			local v4 = tbl.flyAway.SafeGetHRP(v3)
			local v5 = tbl.flyAway.SafeGetHumanoid(v3)

			if v5 and v4 then
				pcall(function()
					local assemblyLinearVelocity = v4.AssemblyLinearVelocity
					v5:ChangeState(Enum.HumanoidStateType.Running)
					local y = assemblyLinearVelocity.Y

					if y > 35 then
						y = 35
					end

					if y < -40 then
						y = -40
					end

					v4.AssemblyAngularVelocity = Vector3.new(1350, 1350, 1350)
					v4.AssemblyLinearVelocity = vector(assemblyLinearVelocity.X * 1, y, assemblyLinearVelocity.Z * 1)
					RunService.RenderStepped:Wait()

					if v4 and v4.Parent then
						v4.AssemblyAngularVelocity = Vector3.zero
					end
				end)
			end
		end)

		table.insert(tbl.flyAway.connections, connection2)
	end

	tbl.flyAway.UpdateButton()
end

