			if not pendingSearch then
				return
			end
			tbl.serverTracker.pendingSearch = nil

			local ok, result = pcall(function()
				return Players:GetUserIdFromNameAsync(pendingSearch)
			end)

			if not (ok and result and result > 0) then
				local ok2, result2 = pcall(function()
					return HttpService:GetAsync("https://users.roblox.com/v1/users/search?keyword=" .. HttpService:UrlEncode(pendingSearch))
				end)

				ok2 = ok2 and result2
				result = nil

				if ok2 then
					local data = HttpService:JSONDecode(result2)
					local flag = data and data.data and #data.data > 0
					result = nil

					if flag then
						result = nil

						for _, v12 in data.data, nil, nil do
							if string.lower(v12.name) == string.lower(pendingSearch) then
								result = v12.id
								break
							else
								result = nil
							end
						end

						result = result or data.data[1].id
					end
				end
			end

			if not result then
				lib:Notify({ Title = fn2("未找到"), Description = fn2("找不到玩家 ") .. pendingSearch, Time = 3 })
				return
			end
			local v12 = nil

			for _, v13 in arg2, nil, nil do
				if v13.PlayerListing then
					for _, v14 in v13.PlayerListing, nil, nil do
						if tonumber(v14) == result then
							v12 = v13
							break
						end
					end
				end

				if not v12 then
					continue
				end
				break
			end

			if v12 then
				local jobId = v12.JobId or v12.jobId

				if jobId then
					local placeId = game.PlaceId

					pcall(function()
						TeleportService:TeleportToPlaceInstance(placeId, jobId, localPlayer)
					end)

					lib:Notify({ Title = fn2("加入"), Description = fn2("正在传送至服务器..."), Time = 2 })
				else
					lib:Notify({ Title = fn2("错误"), Description = fn2("该服务器缺少 JobId"), Time = 3 })
				end
			else
				lib:Notify({ Title = fn2("未找到"), Description = fn2("玩家 ") .. pendingSearch .. fn2(" 不在任何公开服务器中"), Time = 3 })
			end
		end
	end)

	tbl.serverTracker.initialized = true
end

