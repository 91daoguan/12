		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	tbl.resetAnims()
	local animation = Instance.new("Animation")
	animation.AnimationId = animationId
	local animation2 = Instance.new("Animation")
	animation2.AnimationId = animationId2
	local v6 = animator:LoadAnimation(animation)
	local v7 = animator:LoadAnimation(animation2)
	v6.Priority = Enum.AnimationPriority.Action3
	v7.Priority = Enum.AnimationPriority.Action3
	arg.idleTrack = v6
	arg.walkTrack = v7
	arg.active = true

	local function fn6()
		if not arg.active then
			return
		end

		if humanoid.MoveDirection.Magnitude > 0 then
			if not v7.IsPlaying then
				if v6.IsPlaying then
					v6:Stop()
				end

				v7:Play()
			end
		elseif not v6.IsPlaying then
			if v7.IsPlaying then
				v7:Stop()
			end

			v6:Play()
		end
	end

