tbl.doAutoRepair = function()
	if tbl.autoRepairTargetMode == "Aimed" then
		local v9 = tbl.getLookedStructure()

		if v9 then
			local value = v9.Value
			local attribute = v9:GetAttribute("MaxHealth")

			if attribute and value < attribute then
				tbl.fireRepairSilent(v9)
			end
		end

		return
	end

	if tbl.autoRepairTargetMode == "None" then
		return
	end
	local v9, v10 = tbl.getRichBuildables()
	if v10 == 0 then
		return
	end
	local obj

	if tbl.autoRepairTargetMode == "Closest" then
		local dist = v9[1].dist
		obj = v9[1].obj

		for i = 2, v10 do
			if v9[i].dist < dist then
				dist = v9[i].dist
				obj = v9[i].obj
			end
		end
	else
		obj = nil

		if tbl.autoRepairTargetMode == "LowestHealth" then
			local ratio = v9[1].ratio
			local cur = v9[1].cur
			obj = v9[1].obj

			for i = 2, v10 do
				local v11 = v9[i]

				if v11.ratio < ratio or v11.ratio == ratio and v11.cur < cur then
					ratio = v11.ratio
					cur = v11.cur
					obj = v11.obj
				end
			end
		end
	end

	if obj then
		tbl.fireRepairSilent(obj)
	end
end

