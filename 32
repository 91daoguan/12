tbl.AutoEscape.isStillPinned = function()
	local players = workspace:FindFirstChild("Players")
	players = players and players:FindFirstChild(localPlayer.Name)
	players = players and players:FindFirstChild("UserStates")
	players = players and players:FindFirstChild("Pin")
	return players and tostring(players.Value) ~= "None"
end

tbl.AutoEscape.startFloat = function(currentFloatPos)
	if tbl.AutoEscape.suspendConn then
		return
	end
	tbl.AutoEscape.floatStartTime = v()
	tbl.AutoEscape.currentFloatPos = currentFloatPos

	tbl.AutoEscape.suspendConn = RunService.RenderStepped:Connect(function()
		if not tbl.AutoEscape.isProcessing then
			return
		end
		local v16 = tbl.AutoEscape.getHRP()
		if not v16 then
			return
		end
		local floatStartTime = tbl.AutoEscape.floatStartTime
		local n = v() - floatStartTime

		if tbl.AutoEscape.floatDuration <= n then
			tbl.AutoEscape.stopFastClimb()
			tbl.AutoEscape.enableZombieCollision()
			tbl.AutoEscape.isProcessing = false
			tbl.AutoEscape.stopSuspend()
			return
		end

		local floatAmplitude = tbl.AutoEscape.floatAmplitude
		local v17 = vector(tbl.AutoEscape.currentFloatPos.X, tbl.AutoEscape.currentFloatPos.Y + math.sin(n * 3.1415926535897931 * 2) * floatAmplitude, tbl.AutoEscape.currentFloatPos.Z)
		local n2 = v16.CFrame - v16.CFrame.Position
		v16.CFrame = cframe(v17) * n2
		v16.AssemblyLinearVelocity = Vector3.zero
		v16.AssemblyLinearVelocity = Vector3.zero
	end)
end

tbl.AutoEscape.stopSuspend = function()
	if tbl.AutoEscape.suspendConn then
		tbl.AutoEscape.suspendConn:Disconnect()
		tbl.AutoEscape.suspendConn = nil
	end
end

tbl.AutoEscape.doFullTeleport = function()
	if tbl.AutoEscape.isProcessing then
		tbl.AutoEscape.stopSuspend()
		tbl.AutoEscape.stopFastClimb()
		tbl.AutoEscape.enableZombieCollision()
		tbl.AutoEscape.isProcessing = false
	end

	tbl.AutoEscape.isProcessing = true
	tbl.AutoEscape.startFastClimb()
	tbl.AutoEscape.disableZombieCollision()

	while true do
		if tbl.AutoEscape.enabled and tbl.AutoEscape.isStillPinned() then
			local v16 = tbl.AutoEscape.getHRP()

			if v16 then
				local position = v16.Position

				pcall(function()
					v16.CFrame = cframe(position + Vector3.new(0, 5500, 0))
				end)

				while tbl.AutoEscape.enabled and tbl.AutoEscape.isStillPinned() do
					task.wait()
				end

				if tbl.AutoEscape.enabled then
					local n = position + vector(0, tbl.AutoEscape.floatHeight, 0)

					pcall(function()
						v16.CFrame = cframe(n)
					end)

					local players = workspace:FindFirstChild("Players")
					players = players and players:FindFirstChild(localPlayer.Name)
					players = players and players:FindFirstChild("UserStates")
					local pin = players and players:FindFirstChild("Pin")

					if pin then
						pcall(function()
							pin.Value = "None"
						end)
					end

					if tbl.AutoEscape.isStillPinned() then
						continue
					end
				end
			end
		end

		break
	end

	if not tbl.AutoEscape.enabled then
		tbl.AutoEscape.enableZombieCollision()
		tbl.AutoEscape.isProcessing = false
		tbl.AutoEscape.stopFastClimb()
		return
	end

	if tbl.AutoEscape.floatHeight <= 0 then
		tbl.AutoEscape.enableZombieCollision()
		tbl.AutoEscape.isProcessing = false
		tbl.AutoEscape.stopFastClimb()
		return
	end

	local v16 = tbl.AutoEscape.getHRP()

	if v16 then
		tbl.AutoEscape.startFloat(v16.Position)
	else
		tbl.AutoEscape.enableZombieCollision()
		tbl.AutoEscape.isProcessing = false
		tbl.AutoEscape.stopFastClimb()
	end
end

tbl.AutoEscape.startMonitor = function()
	if tbl.AutoEscape.monitorThread then
		return
	end

	tbl.AutoEscape.monitorThread = task.spawn(function()
		local flag = false

		while true do
			task.wait(0.05)

			if not tbl.AutoEscape.enabled then
				flag = false
			else
				local v16 = tbl.AutoEscape.isStillPinned()

				if v16 and not flag then
					task.spawn(tbl.AutoEscape.doFullTeleport)
					flag = v16
					continue
				end

				flag = v16
			end
		end
	end)
end

tbl.AutoEscape.enable = function()
	if tbl.AutoEscape.enabled then
		return
	end
	tbl.AutoEscape.enabled = true
	tbl.AutoEscape.startMonitor()
end

tbl.AutoEscape.disable = function()
	tbl.AutoEscape.enabled = false

	if tbl.AutoEscape.monitorThread then
		task.cancel(tbl.AutoEscape.monitorThread)
		tbl.AutoEscape.monitorThread = nil
	end

	tbl.AutoEscape.isProcessing = false
	tbl.AutoEscape.stopSuspend()
	tbl.AutoEscape.stopFastClimb()
	tbl.AutoEscape.enableZombieCollision()
end

tbl.fallProtectionInstances = {}
tbl.fallProtectionEnabled = false

do
	local n = 0.02
	local n2 = -5
	local n3 = 0
	local connection = nil

	local function fn8(deltaTime)
		if not tbl.fallProtectionEnabled then
			return
		end
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		character = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not character or humanoid.Health <= 0 then
			n3 = 0
			return
		end

		if not (character.AssemblyLinearVelocity.Y < n2 and not UserInputService:IsKeyDown(Enum.KeyCode.Space)) then
			n3 = 0
			return
		end
		n3 += deltaTime

		if n3 >= n then
			n3 = 0

			pcall(function()
				humanoid:ChangeState(Enum.HumanoidStateType.Climbing)
			end)
		end
	end

	tbl.startFallProtection = function()
		if tbl.fallProtectionEnabled then
			return
		end
		tbl.fallProtectionEnabled = true

		if not connection then
			connection = RunService.Heartbeat:Connect(fn8)
		end
	end

	tbl.stopFallProtection = function()
		tbl.fallProtectionEnabled = false
		n3 = 0

		if connection then
			connection:Disconnect()
			connection = nil
		end
	end
end

