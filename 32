								local n = tbl4.getPing() / 1000

								if #tbl4.tpTargetHistory < 2 then
									humanoidRootPart.CFrame = cframe(humanoidRootPart2.Position - humanoidRootPart2.CFrame.LookVector * 4 + Vector3.new(0, 6, 0), humanoidRootPart2.Position)
									task.wait(0.2)
