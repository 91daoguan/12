									local vector3 = Vector3.zero
									local n3 = 0
									local n4 = 0
									local n5 = 0

									for i = max(1, #tbl4.tpTargetHistory - 5) + 1, n2 do
										local v6 = tbl4.tpTargetHistory[i - 1]
										local v7 = tbl4.tpTargetHistory[i]
										local n6 = v7.time - v6.time

