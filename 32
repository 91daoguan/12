					end

					tbl.autoFindDoctor.teleportCount = 0
					tbl.autoFindDoctor.prevHP = v6
				elseif n < tbl.autoFindDoctor.threshold then
					if v6 > tbl.autoFindDoctor.prevHP then
						tbl.autoFindDoctor.teleportCount = 0
						tbl.autoFindDoctor.prevHP = v6
					else
