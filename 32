		ClearMarkers = function()
			for _, v6 in tbl.autoBarrel.markers, nil, nil do
				if v6 and v6.Parent then
					v6:Destroy()
				end
			end

			tbl.autoBarrel.markers = {}
		end,
		MainLoop = function()
			while tbl.autoBarrel.enabled do
				local character = localPlayer.Character
				character = character and character:FindFirstChild("HumanoidRootPart")

				if character then
					local v6 = nil

					for _, v7 in tbl.autoBarrel.zones, nil, nil do
						local v8 = v7.getBarrel()

						if v8 and v8.Parent then
							if (character.Position - v7.markerPos).Magnitude <= 7 then
								v7.barrelObj = v8
								v6 = v7
								break
							else
								v6 = nil
							end
						else
							v6 = nil
						end
					end

					if v6 and tbl.autoBarrel.activeZone ~= v6 then
						tbl.autoBarrel.activeZone = v6
						tbl.autoBarrel.idx = 1
						local v7 = tbl.autoBarrel.FindAxe()

						if v7 then
							tbl.autoBarrel.EquipAxe(v7)
							task.wait(0.3)
						end
					end

					if not v6 and tbl.autoBarrel.activeZone then
						tbl.autoBarrel.activeZone = nil
					end

					if tbl.autoBarrel.activeZone and v6 then
						local v7 = tbl.autoBarrel.GetEvent()

						if v7 then
							local activeZone = tbl.autoBarrel.activeZone

							if not activeZone.barrelObj or not activeZone.barrelObj.Parent then
								activeZone.barrelObj = activeZone.getBarrel()
							end

							if activeZone.barrelObj and activeZone.barrelObj.Parent then
								local v8 = activeZone.attacks[tbl.autoBarrel.idx]
								pcall(v7.FireServer, v7, "PrepareSwing")
								pcall(v7.FireServer, v7, "Swing", "Side")
								pcall(v7.FireServer, v7, "WeaponHitEvent", activeZone.barrelObj, v8.dir, v8.pos)
							end

							tbl.autoBarrel.idx = tbl.autoBarrel.idx + 1

							if tbl.autoBarrel.idx > #activeZone.attacks then
								tbl.autoBarrel.idx = 1
							end
						end
					end
				elseif tbl.autoBarrel.activeZone then
					local v6 = tbl.autoBarrel.FindAxe()

					if v6 then
						pcall(tbl.autoBarrel.UnequipAxe, v6)
					end

					tbl.autoBarrel.activeZone = nil
				end

				task.wait(0.1)
			end
